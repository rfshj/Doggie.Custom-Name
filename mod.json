{
    "geode": "5.9.0",
    "gd": {
        "android": "2.2081",
        "win": "2.2081",
        "mac": "2.2081",
        "ios": "2.2081"
    },
    "version": "v1.0.0",
    "id": "doggie.custom-name",
    "name": "Custom Name",
    "developer": "Doggie",
    "description": "Locally change the name displayed for your own Geometry Dash account.",
    "links": {
       "source": "https://github.com/rfshj/Doggie.Custom-Name"
},
    "resources": {
        "sprites": [
            "resources/*.png"
        ]
    },
    "tags": [
        "customization",
        "enhancement",
        "interface",
        "local"
    ],
    "settings": {
        "enabled": {
            "type": "bool",
            "name": "Enabled",
            "default": false
        },
        "custom-name": {
            "type": "string",
            "name": "Custom Name",
            "default": ""
        },
        "open-menu": {
            "type": "keybind",
            "name": "Open Local Name Menu",
            "default": "F9",
            "category": "universal",
            "allow-in-text-inputs": true
        }
    }
}
